     set(wxTOOLKIT_OPTIONS osx_cocoa gtk2 gtk3 gtk4 qt)
     set(wxPLATFORM OSX)
 elseif(UNIX)
+    # OHOS cross builds report as UNIX-like; offer ohos toolkit alongside GTK/Qt.
     set(wxDEFAULT_TOOLKIT gtk3)
-    set(wxTOOLKIT_OPTIONS gtk2 gtk3 gtk4 qt)
+    set(wxTOOLKIT_OPTIONS gtk2 gtk3 gtk4 qt ohos)
