diff --git a/CMakeLists.txt b/CMakeLists.txt
index 83e5721..c2dd686 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,13 +40,17 @@ cmake_minimum_required(VERSION 3.16)
 # ##############################################################################
 
 set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH} "${CMAKE_SOURCE_DIR}/cmake/Modules/")
-include(OSXDeps)
 
 # ##############################################################################
 # Defaults
 # ##############################################################################
 project("CodeLite")
 
+# OSXDeps must run AFTER project() so if(APPLE) means the *target* platform.
+# Before project(), APPLE reflects the *host* (e.g. macOS) and incorrectly
+# bootstraps OpenSSL/libssh when cross-compiling to OHOS/Linux from a Mac.
+include(OSXDeps)
+
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
@@ -466,8 +470,9 @@ if(WITH_SFTP)
   message("-- LIBSSH_LIB is set to ${LIBSSH_LIB}")
 endif(WITH_SFTP)
 
-# On UNIX we require GTK
-if(UNIX AND NOT APPLE)
+# On UNIX we require GTK (Linux desktop wxGTK builds).
+# HarmonyOS PC uses wxOHOS — do NOT require GTK (ADR-0002).
+if(UNIX AND NOT APPLE AND NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS")
   if(GTK_VERSION EQUAL 3)
     set(OLD_CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH}) # Cache the current value
     set(CMAKE_MODULE_PATH ${CMAKE_MODULE_PATH}
@@ -489,7 +494,7 @@ if(UNIX AND NOT APPLE)
     endif(GTK2_FOUND)
   endif()
 
-endif(UNIX AND NOT APPLE)
+endif()
 
 # find wxWidgets once
 if(MINGW)
